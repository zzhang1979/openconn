pkgname=openconn
pkgver=1.0.0
pkgrel=1
pkgdesc='OpenConnect SSL VPN Client UI with saved credentials and multi-profile support'
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'openconnect' 'polkit')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/openconn "$pkgdir/usr/bin/openconn"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/openconn.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/openconn.svg"
  install -Dm644 "$startdir/openconn.desktop" "$pkgdir/usr/share/applications/openconn.desktop"
}
